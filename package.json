{
  "name": "ring-client",
  "version": "1.0.52",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Zuptalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuptalo/ring.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "showcase": "playwright test --config showcase/showcase.config.ts",
    "drive": "node",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@ionic/vue": "^9.0.5",
    "@ionic/vue-router": "^9.0.5",
    "@zxing/browser": "^0.2.1",
    "emoji-picker-element": "^1.29.1",
    "flubber": "^0.4.2",
    "heic2any": "^0.0.4",
    "ionicons": "^8.1.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lottie-web": "^5.13.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^0.5.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
