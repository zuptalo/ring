# Copy to .env (or export) and adjust as needed. These are also the built-in
# defaults, so the server runs with none of them set once Postgres is up.
#
# In production the things you must set are DATABASE_URL (an external,
# possibly-empty Postgres - the server creates all tables on boot), PUBLIC_URL,
# and SECRETS_KEY. The server's secret material (VAPID, token-signing, TURN) is
# auto-generated on first boot and stored ENCRYPTED in Postgres, so the container
# is stateless (no data volume). The first-run invitation code is logged + lives
# in the invitations table.
PORT=8080
DATABASE_URL=postgres://ring:ring@localhost:5432/ring?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
ENV=dev

# Canonical externally-reachable URL of this server (used by clients to reach
# the backend and to build invitation share links).
PUBLIC_URL=http://localhost:8080

# Encrypts the server's secret material at rest in Postgres (AES-256-GCM).
# REQUIRED outside dev. Generate with `openssl rand -hex 32`. Keep it STABLE and
# backed up: changing or losing it makes the stored secrets unrecoverable (they
# get regenerated, invalidating every device token + push subscription).
SECRETS_KEY=dev-secrets-key-not-for-production

# --- Built-in TLS (ACME / Let's Encrypt) -------------------------------------
# ACME=true makes ringd provision + renew its own certs (autocert, TLS-ALPN-01)
# for the HTTPS app listener (TLS_PORT, default 8443) and the TURNS listener,
# instead of cert files. State is cached encrypted in Postgres (stateless). The
# app/turn hosts' public :443 must PASS THROUGH to ringd un-terminated (an SNI-
# passthrough proxy, not a TLS-terminating one). See server/docs/CALLING.md.
# ACME=true
# ACME_EMAIL=you@example.com            # optional Let's Encrypt account contact
# TLS_PORT=8443                          # HTTPS app port the proxy passes through to
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory  # test first,
#   then delete this line + restart: ringd auto-discards the staging cert and issues a real one.
#
# OLD-ANDROID TRUST: Let's Encrypt chains to ISRG Root X1/X2, which Android <= 7.0
# (e.g. Android 6.0.1) does NOT have in its built-in trust store, and the old DST
# bridge expired in 2024, so those devices show "could not prove it is <host>". To
# fix it, issue from a CA whose older root they DO trust, via External Account
# Binding. Google Trust Services is recommended (default chain -> GlobalSign Root R1,
# in every Android; supports the TLS-ALPN-01 challenge ringd uses). One-time: in a
# Google Cloud project grant roles/publicca.externalAccountKeyCreator and run
# `gcloud publicca external-account-keys create` to get the KID + base64url HMAC key
# (single-use, expires in 7 days). Then set the three lines below and restart; ringd
# auto-discards the old Let's Encrypt cert (cache is namespaced by directory URL) and
# re-issues from the new CA. Do NOT purge the ACME cache afterward (the EAB is
# consumed at registration).
# ACME_DIRECTORY_URL=https://dv.acme-v02.api.pki.goog/directory   # Google Trust Services
# ACME_EAB_KID=<kid-from-the-CA>
# ACME_EAB_HMAC_KEY=<base64url-hmac-from-the-CA>
