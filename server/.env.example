# Copy to .env (or export) and adjust as needed. These are also the built-in
# defaults, so the server runs with none of them set once Postgres is up.
#
# In production the only things you must set are DATABASE_URL (an external,
# possibly-empty Postgres - the server creates all tables on boot) and
# PUBLIC_URL. Everything else (server secrets, the first-run invitation code) is
# auto-generated on first boot and persisted under DATA_DIR.
PORT=8080
DATABASE_URL=postgres://ring:ring@localhost:5432/ring?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
ENV=dev

# Canonical externally-reachable URL of this server (used by clients to reach
# the backend and to build invitation share links).
PUBLIC_URL=http://localhost:8080

# Where auto-generated state lives (secrets.json, first-run-invite.txt).
DATA_DIR=./data
